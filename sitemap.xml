<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:image="http://www.google.com/schemas/sitemap-image/1.1"
  exclude-result-prefixes="s image">

  <xsl:output method="html" encoding="UTF-8" indent="yes"/>

  <xsl:template match="/">
    <html lang="en">
      <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>XML Sitemap — Kiran Kumar V</title>
        <style>
          body{font-family:Inter,system-ui,sans-serif;background:#03060C;color:#E3E9F2;
               padding:2rem 1.2rem;line-height:1.6;max-width:1100px;margin:0 auto}
          h1{font-family:'Fira Code',monospace;color:#0aff99;font-size:1.4rem;margin-bottom:.3rem}
          p.meta{color:#8a9aae;font-size:.85rem;margin-bottom:1.4rem}
          table{width:100%;border-collapse:collapse;font-size:.85rem}
          th,td{padding:.6rem .8rem;border:1px solid rgba(10,255,153,.15);text-align:left;vertical-align:top}
          th{background:rgba(10,255,153,.08);color:#0aff99;font-family:'Fira Code',monospace}
          a{color:#9effcf;text-decoration:none;border-bottom:1px dashed rgba(10,255,153,.4)}
          a:hover{color:#0aff99}
          code{font-family:'Fira Code',monospace;font-size:.8rem;color:#b0f0b0}
          .lang{display:inline-block;padding:.1rem .5rem;border-radius:20px;
                background:rgba(10,255,153,.1);color:#0aff99;font-size:.7rem;
                font-family:'Fira Code',monospace;margin-right:.3rem}
        </style>
      </head>
      <body>
        <h1>XML Sitemap</h1>
        <p class="meta">
          Kiran Kumar V · Senior SEO Analyst ·
          <a href="https://kirankumarvel.github.io/">kirankumarvel.github.io</a>
        </p>
        <table>
          <thead>
            <tr>
              <th>URL</th>
              <th>Last modified</th>
              <th>Change frequency</th>
              <th>Priority</th>
              <th>Alternates</th>
            </tr>
          </thead>
          <tbody>
            <xsl:for-each select="s:urlset/s:url">
              <tr>
                <td><a href="{s:loc}"><xsl:value-of select="s:loc"/></a></td>
                <td><code><xsl:value-of select="s:lastmod"/></code></td>
                <td><xsl:value-of select="s:changefreq"/></td>
                <td><xsl:value-of select="s:priority"/></td>
                <td>
                  <xsl:for-each select="xhtml:link">
                    <span class="lang"><xsl:value-of select="@hreflang"/></span>
                  </xsl:for-each>
                </td>
              </tr>
            </xsl:for-each>
          </tbody>
        </table>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>
